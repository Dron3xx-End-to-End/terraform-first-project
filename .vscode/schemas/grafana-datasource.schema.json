{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grafana datasource provisioning",
  "type": "object",
  "required": ["apiVersion", "datasources"],
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "access", "url"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "access": {
            "enum": ["proxy", "direct"]
          },
          "url": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
